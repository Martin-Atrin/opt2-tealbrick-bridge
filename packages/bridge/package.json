{
  "name": "@opt2-tealbrick/bridge",
  "version": "0.1.20",
  "private": true,
  "type": "module",
  "description": "Bridge core (deployed + relay forms). Never runs agents or calls models.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./relay": {
      "types": "./dist/relay-entry.d.ts",
      "default": "./dist/relay-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@opt2-tealbrick/spec": "https://github.com/Martin-Atrin/opt2-tealbrick-specs/releases/download/spec-v0.1.21/opt2-tealbrick-spec-0.1.21.tgz",
    "@opt2-tealbrick/manifest": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/manifest-v0.1.14/opt2-tealbrick-manifest-0.1.14.tgz"
  }
}
