{
  "name": "@opt2-tealbrick/cli",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "description": "tealbrick CLI: owner mode (drafts, reads), agent mode, stdio relay, harness connection.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "bin": {
    "tealbrick": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@opt2-tealbrick/bridge": "workspace:*",
    "@opt2-tealbrick/harness-claude": "workspace:*",
    "@opt2-tealbrick/manifest": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/manifest-v0.1.18/opt2-tealbrick-manifest-0.1.18.tgz",
    "@opt2-tealbrick/spec": "https://github.com/Martin-Atrin/opt2-tealbrick-specs/releases/download/spec-v0.1.28/opt2-tealbrick-spec-0.1.28.tgz"
  }
}
