{
  "name": "@opt2-tealbrick/cli",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "tealbrick CLI: owner mode (drafts, reads), agent mode, stdio relay, harness connection.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "bin": {
    "tealbrick": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@opt2-tealbrick/spec": "https://github.com/Martin-Atrin/opt2-tealbrick-specs/releases/download/spec-v0.1.2/opt2-tealbrick-spec-0.1.2.tgz",
    "@opt2-tealbrick/bridge": "workspace:*",
    "@opt2-tealbrick/harness-claude": "workspace:*"
  }
}
