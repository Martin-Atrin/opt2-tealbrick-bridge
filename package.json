{
  "name": "opt2-tealbrick-bridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check . && node scripts/check-literals.ts",
    "test": "tsc -p packages/bridge/tsconfig.build.json && tsc -p packages/harness-claude/tsconfig.build.json && node --test --test-timeout=60000 \"packages/*/test/**/*.test.ts\"",
    "conformance": "npm run build && node --test --test-timeout=60000 packages/bridge/test/bridge.test.ts && node scripts/conformance.ts",
    "build": "tsc -p packages/bridge/tsconfig.build.json && tsc -p packages/bridge-server/tsconfig.build.json && tsc -p packages/harness-claude/tsconfig.build.json && tsc -p packages/harness-eve/tsconfig.build.json && tsc -p packages/cli/tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opt2-tealbrick/conformance": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/conformance-v0.1.11/opt2-tealbrick-conformance-0.1.11.tgz",
    "@opt2-tealbrick/miniapp-sdk": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/miniapp-sdk-v0.1.15/opt2-tealbrick-miniapp-sdk-0.1.15.tgz",
    "@types/node": "24.19.2",
    "fast-check": "4",
    "typescript": "5.9.3"
  }
}
