{
  "name": "opt2-tealbrick-bridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check . && node scripts/check-literals.ts",
    "test": "pnpm -r run build && node --test --test-timeout=60000 \"packages/*/test/**/*.test.ts\"",
    "conformance": "pnpm -r run build && node --test --test-timeout=60000 packages/bridge/test/bridge.test.ts",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
