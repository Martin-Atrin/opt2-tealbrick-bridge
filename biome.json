{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/.tb-ci"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noTemplateCurlyInString": "off"
      },
      "correctness": {
        "noVoidTypeReturn": "off"
      }
    }
  }
}